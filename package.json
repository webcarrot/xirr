{
  "name": "@webcarrot/xirr",
  "version": "3.0.1",
  "description": "JavaScript implementation of the XIRR LibreOffice Calc function.",
  "type": "module",
  "main": "cjs/mod.js",
  "module": "esm/mod.js",
  "types": "./mod.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/mod.d.js",
        "default": "./esm/mod.js"
      },
      "require": {
        "types": "./cjs/mod.d.js",
        "default": "./cjs/mod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webcarrot/xirr.git"
  },
  "keywords": [
    "xirr"
  ],
  "files": [
    "cjs",
    "esm",
    "mod.ts"
  ],
  "scripts": {
    "clear": "rm -rf ./esm ./cjs",
    "prepack": "npm run clear && npm run build",
    "postpack": "npm run clear",
    "build:esm": "tsc --ignoreConfig --sourceMap --declarationMap -d -t es2022 --module es2022 --outDir ./esm ./mod.ts",
    "build:cjs": "tsc --ignoreConfig --sourceMap --declarationMap -d -t es2022 --module commonjs --outDir ./cjs ./mod.ts",
    "build:cjs:package": "echo '{\"type\": \"commonjs\"}' > ./cjs/package.json",
    "build": "npm run build:esm && npm run build:cjs && npm run build:cjs:package",
    "test": "tsc --ignoreConfig -t es2022 --noEmit ./mod.ts && node --test mod.test.ts"
  },
  "author": {
    "email": "admin@webcarrot.pl",
    "name": "webcarrot"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webcarrot/xirr/issues"
  },
  "homepage": "https://github.com/webcarrot/xirr#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
